# XI: Forever Offline: allow-list.
# Everything in this folder is ignored unless it is listed below, so passwords,
# ROMs, game files, backups and logs can't be added by accident.
/*

# ---- project files ----
!/.gitignore
!/README.md
!/CREDITS.md
!/LICENSE
!/config.example.json

# ---- launcher ----
!/launcher_core.py
!/launcher_gui.pyw
!/launcher_squad.py
!/launcher_squad_backup.py
!/launcher_rules.py
!/launcher_icons.py
!/launcher_personality.py
# the newer look (2026-11): the pages, their controls, and where each setting goes
!/launcher_pages.py
!/launcher_widgets.py
!/launcher_settings.py
!/launcher_gamepad.py
!/launcher_theme.py
!/launcher_hood.py
!/launcher_hd.py
!/launcher_hd_gui.py
# Stinkshell, the online chat room (off by default; its relay is dev/stinkshell/stinkshell_relay.py)
!/launcher_stinkshell.py
# Hardcore modes (Iron / Steel / Silver): the menu, and the three rate profiles (hardcore.json / hardcore_state.json stay yours)
!/launcher_hardcore.py
!/launcher_hardcore_gui.py
# Character pages on xiforever.com and the XIFO phone app (armory.json stays yours)
!/launcher_armory.py
!/launcher_armory_gui.py
!/launcher_ventures.py
!/launcher_charcards.py
!/launcher_charcards_gui.py
!/hardcore_profiles.json
!/launcher_revamped.py
!/launcher_thirdparty.py
!/launcher_setup.py
!/REVAMPED-SHELLS.md
!/launcher_update.py
!/launcher_publish.py
# contributor mode: team members send updates for review; who may is in contributors.json (main branch on GitHub)
!/launcher_contrib.py
!/contributors.json
!/launcher_game.py
!/launcher_gamefiles.py
!/launcher_client.py
!/stack_mode.py
# co-op (experimental): the CO-OP page, the service two launchers talk through, and character passports
!/launcher_coop_gui.py
!/launcher_coop.py
!/launcher_passport.py
# open worlds (2026-11-23): a world that runs without the launcher's window (the hub, a rented server): start and
# watch, first setup, nightly backups and its own updates; and the one command that installs it on a Linux server.
# install-world.sh has to keep Unix line ends, which .gitattributes says.
!/launcher_world.py
!/launcher_world_setup.py
!/launcher_world_keep.py
!/install-world.sh
!/.gitattributes
# the open worlds a launcher lists without being given a link (The Hub first). The kit ships this copy; launchers
# read the current one from https://xiforever.com/worlds.json, so that is the copy to change when the hub moves
!/worlds.json
# (2026-11-21) used by the launcher but never shipped before: item stacks (Egon's report), character transfer, patch notes page
!/stack_mode.py
!/char_import.py
!/PATCH-NOTES.md
# (2026-11-21) Forever Beta Shirt: builds its look and item entry from the player's own game files (launcher_client step 5)
!/forever_beta_shirt.py
# (2026-11-25) Forever Patch: the same for the eyepatch (launcher_client step 5b)
!/forever_patch.py
# (2026-11-25) Forever Jeans: the same for the beta testers' legs (launcher_client step 5c)
!/forever_jeans.py
# (2026-11-25) certificate checks without Windows' stale intermediate store (launcher_core installs it)
!/launcher_tls.py
# Linux / Steam Deck: Proton, the game's own prefix, the menu entry; the Linux build and its GitHub workflow
!/launcher_linux.py
!/build_release.sh
!/README-LINUX.md
!/.github/
!/client-patches/
!/thirdparty.json
# launcher_classic.pyw and "Classic launcher.bat" (the old look) stay on the dev PC only
!/launcher.bat
!/launcher.ps1
!/Create Desktop Shortcut.bat
!/make-shortcut.ps1
!/build_release.ps1
!/package_server.py
!/package_kit.py
!/RELEASING.md

