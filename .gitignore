!/assets/worlds/
/assets/worlds/*
!/assets/worlds/hub_banner.jpg

# ---- tests ----
!/dev/
/dev/_to_delete/

# ---- never, anywhere (these lines come last so they win) ----
*.before-*
*.bak
*.retired
*.tgz
*.zip
*.rar
*.7z
*.pyc
__pycache__/
*.log
*_v[0-9]*.*
*.gb
*.gbc
*.sav
!/crystalboy-games/*.gb
!/crystalboy-games/*.gbc
*.sn1
*.DAT
*.dat
*.exe
*.dll
!/thirdparty-bundled/*/plugins/*.dll
!/thirdparty-bundled/*/cores/*.dll
config.json
desktop.ini
Thumbs.db
# the Linux launcher (built by build_release.sh) and what a Linux install makes in the kit folder
/XI-Forever-Offline
/proton/
/prefix/
/ollama/
/mariadb/
*.tar.gz
*.tar.zst

# face reference pictures downloaded from FFXIclopedia (not shipped)
/art-src/faces/
/dev/incoming/
drawdistance.json
/crowds/bots/modules/

