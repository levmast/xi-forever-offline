# XI: Forever Offline: allow-list.
# Everything in this folder is ignored unless it is listed below, so passwords,
# ROMs, game files, backups and logs can't be added by accident.
/*

# ---- project files ----
!/.gitignore
!/README.md
!/CREDITS.md
!/LICENSE
!/config.example.json

# ---- launcher ----
!/launcher_core.py
!/launcher_gui.pyw
!/launcher_squad.py
!/launcher_rules.py
!/launcher_icons.py
!/launcher_personality.py
!/launcher_thirdparty.py
!/launcher_setup.py
!/launcher_update.py
!/launcher_publish.py
# contributor mode: team members send updates for review; who may is in contributors.json (main branch on GitHub)
!/launcher_contrib.py
!/contributors.json
!/launcher_game.py
!/launcher_client.py
# co-op (experimental): the CO-OP page, the service two launchers talk through, and character passports
!/launcher_coop_gui.py
!/launcher_coop.py
!/launcher_passport.py
# Linux / Steam Deck: Proton, the game's own prefix, the menu entry; the Linux build and its GitHub workflow
!/launcher_linux.py
!/build_release.sh
!/README-LINUX.md
!/.github/
!/client-patches/
!/thirdparty.json
# launcher_classic.pyw and "Classic launcher.bat" (the old look) stay on the dev PC only
!/launcher.bat
!/launcher.ps1
!/Create Desktop Shortcut.bat
!/make-shortcut.ps1
!/build_release.ps1
!/package_server.py
!/package_kit.py
!/RELEASING.md

# ---- server setup and updates ----
!/setup.ps1
!/rebuild.ps1
!/Rebuild server.bat
!/check-rebuild.ps1
!/check-updates.ps1
!/server_update.py
!/install-era-dats.ps1
!/restore-original-dats.ps1
!/get-reshade-packs.ps1

# ---- simulators, tools and data builders ----
!/ah_sim.py
# the market prices the auction house simulator lists at (HorizonXI, from "python ah_sim.py prices"); without it every
# item fell back to a vendor-price guess (Leaping Boots for 700 gil)
!/ah_prices.json
!/conquest_sim.py
# main_auto.py (database password in it) and chat_cleanup.py (one-off patcher) are not shared
!/house_rules.py
!/setup_gm.py
!/setup_dualbox.py
!/cleanup_characters.py
!/free_names.py
!/fix_equip.py
!/restore_retail_homepoints.py
!/make_no_voidwatch.py
!/build_casket_loot.py
!/build_mobdb_data.py
!/build_starter_gear.py
!/era-exp-table.txt

# ---- Crystal Boy ----
!/README-CRYSTALBOY.md
!/install_crystalboy.py
!/install_crystalboy_items.py
!/crystalboy/
!/crystalboy-games/
!/crystalboy-server/
!/thirdparty-bundled/

# ---- addons (our own only; third-party ones are downloaded at install) ----
!/addons-src/
/addons-src/*
!/addons-src/Gambits/
!/addons-src/followme/
!/addons-src/servermenu/
!/addons-src/squadpanel/
!/addons-src/journal-era/

# ---- server modules (copies kept with the kit) ----
!/squad-behavior/
!/squad-data/
# each player's own greeting lines for their mates
/squad-data/squad_greetings_user.json
!/era_exp/
!/rse/
!/travel/
!/af_party/
!/caskets/
!/crowds/
/crowds/bots/chat_memory/

# ---- written dialogue for the bots and squad mates (dialogue packs, our voice layer, the builder, the built lines) ----
!/dialogue/

# ---- squad chat (AI) ----
!/squad-chat/
/squad-chat/*
!/squad-chat/squad_chat.py
!/squad-chat/README.md
!/squad-chat/lore/
!/squad-chat/examples/

# ---- art: Square Enix material is credited in CREDITS.md ----
!/art-src/
/art-src/ff11-logo*
!/assets/
/assets/*
!/assets/ui/
!/assets/press/
!/assets/crystalboy/
!/assets/item-icons/
!/assets/promo/
!/assets/faces/

# ---- tests ----
!/dev/
/dev/_to_delete/

# ---- never, anywhere (these lines come last so they win) ----
*.before-*
*.bak
*.retired
*.tgz
*.zip
*.rar
*.7z
*.pyc
__pycache__/
*.log
*_v[0-9]*.*
*.gb
*.gbc
*.sav
!/crystalboy-games/*.gb
!/crystalboy-games/*.gbc
*.sn1
*.DAT
*.dat
*.exe
*.dll
!/thirdparty-bundled/*/plugins/*.dll
config.json
desktop.ini
Thumbs.db
# the Linux launcher (built by build_release.sh) and what a Linux install makes in the kit folder
/XI-Forever-Offline
/proton/
/prefix/
/ollama/
/mariadb/
*.tar.gz
*.tar.zst

# face reference pictures downloaded from FFXIclopedia (not shipped)
/art-src/faces/
